# Dependensi lokal (wajib dikecualikan agar tidak mengotori image)
vendor/
node_modules/
frontend/

# Berkas rahasia dan konfigurasi lingkungan (kecualikan file environment, tapi izinkan .env.example sebagai template)
.env
.env.backup
.env.production
.env.local
*.env
!.env.example

# Sistem kontrol versi Git
.git/
.github/
.gitignore
.gitattributes

# Berkas pengujian dan dokumentasi
tests/
*.md

# Berkas cache sementara
.phpunit.cache/
.phpunit.result.cache
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*

# Editor dan metadata OS
.idea/
.vscode/
*.DS_Store
Thumbs.db
